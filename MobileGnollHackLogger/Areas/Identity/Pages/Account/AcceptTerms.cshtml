@page
@model AcceptTermsModel
@{
    ViewData["Title"] = "Accept Terms of Service";
    ViewData["MainClass"] = "main-narrow";
}

<div class="row login-page-container">
    <div class="center-box login-box">
        <section>
            <div class="login-header text-center">
                <h1 class="hero-title">GnollHack</h1>
                <div class="ornament"></div>
                <p class="login-subtitle">ACCEPT TERMS OF SERVICE</p>
            </div>

            <form id="acceptTermsForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="login-form disable-button-on-submit">
                <div class="login-form-inner">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <p class="mb-4">Please review and accept the GnollHack Account Terms of Service to continue using your account.</p>

                    <div class="form-check terms-consent">
                        @* data-val="false": jQuery Validate cannot evaluate [Range] on a checkbox and would reject a checked box; the server validates it. *@
                        <input asp-for="Input.AcceptTerms" class="form-check-input" type="checkbox" data-val="false" />
                        <label asp-for="Input.AcceptTerms" class="form-check-label">I am at least 13 years old, and if I am under 18 my parent or guardian has agreed to these Terms. I agree to the <a href="@Model.TermsUrl" target="_blank" rel="noopener">GnollHack Account Terms of Service</a>, and I have read the <a href="@Model.PrivacyPolicyUrl" target="_blank" rel="noopener">GnollHack Account Privacy Policy</a>.</label>
                        <span asp-validation-for="Input.AcceptTerms" class="text-danger"></span>
                    </div>
                    <input type="hidden" asp-for="Input.TermsVersion" />

                    <div class="login-button-container text-center mb-3">
                        <button id="acceptTermsSubmit" type="submit" class="btn btn-fantasy-login w-100">
                            <span>ACCEPT AND CONTINUE</span>
                        </button>
                    </div>
                </div>
            </form>

            <form id="acceptTermsSignOut" class="text-center mt-3" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                <p class="signup-text mb-0">
                    <button id="acceptTermsSignOutSubmit" type="submit" class="btn btn-link signup-link p-0 align-baseline">Sign out</button>
                </p>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
