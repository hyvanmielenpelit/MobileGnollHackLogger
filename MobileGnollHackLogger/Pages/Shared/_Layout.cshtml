@inject IWebHostEnvironment WebHostEnvironment
@inject IConfiguration Configuration
@inject GnollHackServer.Data.Legal.TermsAcceptanceStore TermsAcceptanceStore
@inject GnollHackServer.Data.Legal.LegalDocumentReader LegalDocumentReader
@{
    // The footer link is optional; a failed lookup must not stop a page, the error page included, from rendering.
    string? accountTermsUrl = null;
    try
    {
        accountTermsUrl = await TermsAcceptanceStore.GetRequiredVersionAsync(GnollHackServer.Data.Legal.LegalDocumentKeys.AccountTerms) != null
            ? LegalDocumentReader.GetWikiUrl(GnollHackServer.Data.Legal.LegalDocumentKeys.AccountTerms)
            : null;
    }
    catch (Exception)
    {
        accountTermsUrl = null;
    }

    // Tag Manager is loaded by site.js from the consent notice, only after Accept.
    string? googleTagManagerId = Configuration["GoogleTagManagerID"];
    string cookiePolicyUrl = LegalDocumentReader.PageUrl("GnollHack Account Cookie Policy");
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(!string.IsNullOrEmpty(ViewData["Title"] as string) ? (ViewData["Title"] as string) + " - " : "")GnollHack Account</title>
    <link rel="preload" href="~/fonts/cinzel-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/lato2-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MobileGnollHackLogger.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <link rel="apple-touch-icon-precomposed" sizes="57x57" href="~/apple-touch-icon-57x57.png" />
    <link rel="apple-touch-icon-precomposed" sizes="114x114" href="~/apple-touch-icon-114x114.png" />
    <link rel="apple-touch-icon-precomposed" sizes="72x72" href="~/apple-touch-icon-72x72.png" />
    <link rel="apple-touch-icon-precomposed" sizes="144x144" href="~/apple-touch-icon-144x144.png" />
    <link rel="apple-touch-icon-precomposed" sizes="60x60" href="~/apple-touch-icon-60x60.png" />
    <link rel="apple-touch-icon-precomposed" sizes="120x120" href="~/apple-touch-icon-120x120.png" />
    <link rel="apple-touch-icon-precomposed" sizes="76x76" href="~/apple-touch-icon-76x76.png" />
    <link rel="apple-touch-icon-precomposed" sizes="152x152" href="~/apple-touch-icon-152x152.png" />
    <link rel="icon" type="image/png" href="~/favicon-196x196.png" sizes="196x196" />
    <link rel="icon" type="image/png" href="~/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/png" href="~/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="~/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="~/favicon-128.png" sizes="128x128" />
    <meta name="application-name" content="&nbsp;" />
    <meta name="msapplication-TileColor" content="#FFFFFF" />
    <meta name="msapplication-TileImage" content="~/mstile-144x144.png" />
    <meta name="msapplication-square70x70logo" content="~/mstile-70x70.png" />
    <meta name="msapplication-square150x150logo" content="~/mstile-150x150.png" />
    <meta name="msapplication-wide310x150logo" content="~/mstile-310x150.png" />
    <meta name="msapplication-square310x310logo" content="~/mstile-310x310.png" />
</head>
<body>
        <nav class="navbar navbar-expand-lg navbar-toggleable-lg bg-white border-bottom box-shadow mb-3 sticky-top" style="z-index: 1030;" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">GnollHack Account</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item dropdown" data-bs-theme="dark">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Results
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-page="/TopScores">Top Scores</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-page="/RecentGames">Recent Games</a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown" data-bs-theme="dark">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Statistics
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-page="/Statistics">Win Rates</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-page="/BonesTransactions">Bones Sharing</a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown" data-bs-theme="dark">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Links
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" href="https://gnollhack.com/">
                                        GnollHack.com
                                        <i class="bi bi-box-arrow-up-right h-line"></i>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="https://wiki.gnollhack.com/">
                                        GnollHack Wiki
                                        <i class="bi bi-box-arrow-up-right h-line"></i>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="https://overseer.gnollhack.com/">
                                        Gnoll Overseer
                                        <i class="bi bi-box-arrow-up-right h-line"></i>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="https://github.com/hyvanmielenpelit/GnollHack">
                                        GnollHack GitHub Repository
                                        <i class="bi bi-box-arrow-up-right h-line"></i>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="https://nethackscoreboard.org/">
                                        NetHack Scoreboard
                                        <i class="bi bi-box-arrow-up-right h-line"></i>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="https://junethack.net/">
                                        Junethack
                                        <i class="bi bi-box-arrow-up-right h-line"></i>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Contact">Contact</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>

    <div class="container @ViewData["ContainerClass"]">
        <main role="main" class="@ViewData["MainClass"]">
            @RenderBody()
        </main>
    </div>

    @if (!string.IsNullOrEmpty(googleTagManagerId))
    {
        <div id="consentDiv" class="consent" role="region" aria-label="Cookie consent" data-gtm-id="@googleTagManagerId">
            <div class="text-container">
                We&rsquo;d like to use optional Google cookies and tags (Tag Manager and Analytics) to measure visits.
                They load only if you accept. You can change your choice at any time under Cookie Settings in the footer.
                See our <a target="_blank" rel="noopener" href="@cookiePolicyUrl">Cookie Policy</a>.
            </div>
            <div class="button-container">
                <button type="button" id="consentAcceptButton" data-consent-choice="accepted">Accept</button>
                <button type="button" id="consentDeclineButton" data-consent-choice="declined">Decline</button>
            </div>
        </div>
    }

    <footer class="footer text-muted border-top">
        <div class="container">
                &copy; @DateTime.Now.Year <i class="bi bi-dash"></i> GnollHack Account <i class="bi bi-dash"></i> @WebHostEnvironment.EnvironmentName <i class="bi bi-dash"></i> <a target="_blank" href="@LegalDocumentReader.PageUrl("GnollHack Account Privacy Policy")">Privacy</a>
                <i class="bi bi-dash"></i> <a target="_blank" rel="noopener" href="@cookiePolicyUrl">Cookie Policy</a>
                @if (!string.IsNullOrEmpty(googleTagManagerId))
                {
                    <i class="bi bi-dash"></i> <button type="button" id="cookieSettingsButton" class="footer-link-button">Cookie Settings</button>
                }
                @if (accountTermsUrl != null)
                {
                    <i class="bi bi-dash"></i> <a target="_blank" href="@accountTermsUrl">GnollHack Account Terms of Service</a>
                }
                <i class="bi bi-dash"></i> <a target="_blank" href="@LegalDocumentReader.PageUrl("Gnoll Overseer Terms of Service")">Gnoll Overseer Terms of Service</a>
        </div>
    </footer>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>