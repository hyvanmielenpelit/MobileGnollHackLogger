<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>ClientApp\</SpaRoot>
    <SpaProxyServerUrl>https://localhost:44447</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
    <UserSecretsId>e5696576-54da-4b91-af38-1aae06a0dd05</UserSecretsId>
    <Version>1.0.18</Version>
    <TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.11" />
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00016" />
    <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00016" />
    <PackageReference Include="Lucene.Net.QueryParser" Version="4.8.0-beta00016" />
    <PackageReference Include="Sentry.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ToolGuides\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Data\**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Services\ModelCatalogs\*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GnollHackServer.Data\GnollHackServer.Data.csproj" />
  </ItemGroup>

  <Target Name="SyncAngularVersion" BeforeTargets="Build" Condition="'$(Version)' != ''">
    <Exec WorkingDirectory="ClientApp" Command="npm version $(Version) --no-git-tag-version --allow-same-version" IgnoreExitCode="true" />
  </Target>

  <Target Name="PublishAngular" BeforeTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="ClientApp" Command="npm ci" />
    <Exec WorkingDirectory="ClientApp" Command="npx ng build --configuration production" />
    <ItemGroup>
      <DistFiles Include="wwwroot\**" Exclude="wwwroot\**\*.map" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
