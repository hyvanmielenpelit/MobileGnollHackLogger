*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.bmp binary
*.tiff binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Documents
*.pdf binary
*.doc binary
*.docx binary

# Archives, Compressed Files, and WebAssembly
*.zip binary
*.tar.gz binary
*.tgz binary
*.gz binary
*.br binary
*.wasm binary

# Binaries and Compiled Libraries
*.dll binary
*.exe binary
*.pdb binary
